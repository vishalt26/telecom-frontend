# Copy to .env.local for local dev. VITE_* vars are public — never put secrets here.

# Spring Boot backend base URL (see docs/api-contract.md). Its CORS allow-list is
# locked to localhost:5173, which is why vite.config.js pins the dev server to that port.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# false (default): use the real backend above. Set to true to fall back to an
# in-browser mock matching the API contract (useful if the backend isn't running).
VITE_USE_MOCK=false
